{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(rustup:*)",
      "Bash(pnpm:*)",
      "Bash(npx turbo:*)",
      "Bash(node:*)",
      "Bash(docker compose:*)",
      "Bash(tests/e2e/turbo.sh:*)",
      "Bash(STORAGE=r2 tests/e2e/turbo.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-decisions.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
